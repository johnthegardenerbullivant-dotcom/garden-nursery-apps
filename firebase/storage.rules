rules_version = '2';

// =============================================================
//  COMBINED Firebase Storage Security Rules
//  Garden Management + Nursery Management
//  Firebase project: bbg-garden-inventory
//  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
//  Mirrors the Firestore role model using a simpler pattern:
//    - Any authenticated user can READ (view photos)
//    - Editors and admins can WRITE (upload photos)
//    - Admins can DELETE photos
//
//  NOTE: Storage rules cannot directly read Firestore documents,
//  so we use a simplified token-based check. Role enforcement
//  for storage is best handled server-side by checking Firestore
//  before calling uploadPhoto() — which the app already does via
//  the isAtLeast() check in the UI.
//
//  THIS IS THE ONLY COPY OF THIS FILE. It used to exist twice,
//  once inside each app's deploy folder. As of the monorepo
//  restructure it lives here only, and is not served by Netlify.
//
//  HOW TO DEPLOY — from the firebase/ folder:
//    firebase deploy --only firestore:rules,storage
// =============================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Plant photos: plant-photos/{plantId}/{filename}
    match /plant-photos/{plantId}/{allPaths=**} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null;   // Enforced at app level by isAtLeast('editor')
      allow delete: if request.auth != null;   // Enforced at app level by isAtLeast('admin')
    }

    // Area photos: area-photos/{areaId}/{filename}
    match /area-photos/{areaId}/{allPaths=**} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Nursery photos: nursery-photos/{batchId}/{filename}
    match /nursery-photos/{batchId}/{allPaths=**} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null;   // Enforced at app level by isAtLeast('editor')
      allow delete: if request.auth != null;   // Enforced at app level by isAtLeast('editor')
    }

    // Blog post photos: blog-photos/{postId}/{filename}
    match /blog-photos/{postId}/{allPaths=**} {
      allow read:   if true;            // Public — matching Firestore blogPosts read rule
      allow write:  if request.auth != null;   // Enforced at app level by isAtLeast('admin')
      allow delete: if request.auth != null;
    }

    // Default: deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
