# =============================================================
#  garden-apps — ignore rules
#  This repo is PRIVATE and deliberately contains the real
#  Firebase web config in apps/*/firebase-config.js. Do not add
#  firebase-config.js here — Netlify needs it in the published
#  output, and Firestore rules are what protect the data.
# =============================================================

# Personal data — never commit. Backups and the bulk plant import
# live outside the repo, in C:\Users\johnb\Documents\Claude\Garden Data\
Backups/
*backup*.json
plant-import.json

# Netlify / Firebase local state
.netlify/
.firebase/
firebase-debug.log
firestore-debug.log

# Editor and OS noise
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.orig
*~
err.txt

# Build output. The shared design layer lives at /shared and is copied into each
# app's folder at build time by the command in its netlify.toml, because a folder
# outside the publish directory is not served. Those copies are generated, never
# committed — edit /shared, not apps/*/shared/.
apps/*/shared/

# Node — the only build step is a `cp`, but keep these out if npm ever appears
node_modules/
