# =============================================================
#  garden-apps — ignore rules
#
#  The Firebase web config is NOT committed. tools/build.mjs
#  generates apps/*/firebase-config.js from FIREBASE_* environment
#  variables at build time, on Netlify and locally alike.
#
#  That is not a secrecy measure — the config is readable by anyone
#  who views source on the live site, and Firestore rules are what
#  protect the data. It is so that a copy of this repo contains no
#  file its owner has to edit, and can therefore take updates as a
#  clean fast-forward. See docs/distribution-plan.md.
# =============================================================

# Generated by tools/build.mjs — never commit, never edit by hand.
apps/*/firebase-config.js
apps/*/app-config.js

# Local values for tools/build.mjs. Netlify sets real environment
# variables instead; this file is purely a local convenience.
.env

# Written by `firebase use --add`, and specific to whichever Firebase
# project this checkout belongs to.
firebase/.firebaserc

# Installation-specific notes: project ID, live URLs, where the private data
# folder is on this machine. Kept out of the tracked docs so that a fork does
# not carry another installation's details around as if they were its own.
LOCAL.md

# Personal data — never commit. Backups and the bulk plant import live
# outside the repo entirely; see LOCAL.md for where, on this machine.
Backups/
*backup*.json
plant-import.json

# Netlify / Firebase local state
.netlify/
.firebase/
firebase-debug.log
firestore-debug.log

# Editor and OS noise
.DS_Store
Thumbs.db
desktop.ini
*.bak
*.orig
*~
err.txt

# Build output. The shared design layer lives at /shared and is copied into each
# app's folder at build time by the command in its netlify.toml, because a folder
# outside the publish directory is not served. Those copies are generated, never
# committed — edit /shared, not apps/*/shared/.
apps/*/shared/

# Node — the only build step is a `cp`, but keep these out if npm ever appears
node_modules/
